public class Main {
    public static void main(String[] args) {
        System.out.println("Realizando calculo:");
        informacoes(50, 10);
    }
    public static void informacoes(int n1, int n2) {
        int resultado = (n1 * n2) - (n1 * n2) / (n1 - n2);
        System.out.println("O resultado da equação é:" + resultado);
    }
}
